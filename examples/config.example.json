{
  "$schema": "https://json.schemastore.org/schema",
  "TenantConfiguration": {
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "11111111-1111-1111-1111-111111111111",
    "ClientSecret": "YOUR_AZURE_APP_CLIENT_SECRET_HERE",
    "Authority": "https://login.microsoftonline.com"
  },
  "AuditPolicy": {
    "PrivilegedInactivityThresholdDays": 60,
    "FlagMissingMFAOnAdmins": true,
    "AuditLookbackHours": 48,
    "MaxSecretValidityDays": 730
  },
  "Alerting": {
    "WebhookUrl": "https://outlook.office.com/webhook/your-teams-webhook-url",
    "MinimumSeverity": "HIGH",
    "AlertOnCriticalEscalations": true
  },
  "Reporting": {
    "OutputDirectory": "./Reports",
    "Formats": ["JSON", "HTML", "CSV"]
  }
}
